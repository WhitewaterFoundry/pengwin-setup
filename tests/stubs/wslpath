#! /bin/bash

# shellcheck source=./../mocks.sh
source "$(dirname "$0")/../mocks.sh" "$@"

if [[ "$1" == "-u" ]]; then
  windows_path="$2"
else
  windows_path="$1"
fi

case "${windows_path}" in
  'C:\')
    echo "/"
    ;;
  'C:\Users\user')
    echo "${HOME}"
    ;;
  'C:\Users\user\Desktop')
    echo "${HOME}/windows/Desktop"
    ;;
  'C:\Users\user\Documents')
    echo "${HOME}/windows/Documents"
    ;;
  'C:\Users\user\Downloads')
    echo "${HOME}/windows/Downloads"
    ;;
  'C:\Users\user\Music')
    echo "${HOME}/windows/Music"
    ;;
  'C:\Users\user\Pictures')
    echo "${HOME}/windows/Pictures"
    ;;
  'C:\Users\user\Videos')
    echo "${HOME}/windows/Videos"
    ;;
  'C:\Users\user\Templates')
    echo "${HOME}/windows/Templates"
    ;;
  'C:\Users\user\Public')
    echo "${HOME}/windows/Public"
    ;;
  *)
    exit 1
    ;;
esac
